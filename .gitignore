# Large unused model checkpoints (keep best_model.pth)
backend/models/best_resnet50.pth
backend/models/last_model.pth
backend/export/*.pth

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
