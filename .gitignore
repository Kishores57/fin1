# Python bytecode & environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# Node modules & build outputs
node_modules/
dist/
build/
.next/
out/

# Environment secrets
.env
.env.*
!.env.example
!.env.template

# Databases & Vector Stores
*.db
*.sqlite
*.sqlite3
chroma_db/
backend/chroma_db/

# Uploads & Temporary Media (preserve directory structure via .gitkeep)
uploads/*
