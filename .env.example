# ==============================================================================
# AI-Powered GIS Tree Inventory & Climate Impact Analysis Platform
# Environment Configuration Template
# ==============================================================================

# Server Port (assigned automatically by cloud platforms like Render/Railway)
PORT=8000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
# SQLite database path (default used for tree calculation tables & metrics)
DATABASE_URL=sqlite:///./tree_analysis.db

# MongoDB Atlas connection string (for registered field trees & user uploads)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tree_analysis?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/tree_analysis?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# AI & Machine Learning Services
# ------------------------------------------------------------------------------
# Google Gemini API Key for dynamic ecological and climatic RAG summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Python Species Detection Model Service URL (default local port 5000)
# In production, set this to your hosted model service URL or internal container hostname
DETECTION_URL=http://127.0.0.1:5000

# ------------------------------------------------------------------------------
# Epicollect5 Live Geospatial Survey Credentials
# ------------------------------------------------------------------------------
EPICOLLECT_PROJECT_SLUG=vanjeevan
EPICOLLECT_CLIENT_ID=your_epicollect_client_id_here
EPICOLLECT_CLIENT_SECRET=your_epicollect_client_secret_here

# ------------------------------------------------------------------------------
# Networking & CORS
# ------------------------------------------------------------------------------
# Allowed CORS origins (comma-separated or '*' to allow all)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Frontend Specific (for Vercel / Netlify / Separate Frontend Hosting)
# ------------------------------------------------------------------------------
# Set this to your deployed backend URL (e.g., https://your-tree-backend.onrender.com)
# When frontend is served directly by the Express backend, this can remain empty.
VITE_API_URL=
